# ==========================================
# [FICC Daily Macro] 환경변수 설정 템플릿
# 이 파일을 복사하여 .env 파일을 생성하고 실제 API Key를 입력하세요.
# ==========================================

# 1. LLM Provider 설정 (gemini 또는 openai)
LLM_PROVIDER=gemini

# 2. LLM Model 설정 (기본값: gemini-3.7-flash)
LLM_MODEL=gemini-3.7-flash

# 3. API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 4. (선택사항) BOK ECOS API Key
BOK_ECOS_API_KEY=
